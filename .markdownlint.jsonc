// Markdown rules of this repository. Long lines are allowed, because a
// paragraph is one line. HTML is allowed, because a README may need it for
// an image or a <details> block. The README opens with its licence comment,
// so its first line is not a heading. A heading may repeat under a
// different parent.
{
  "default": true,
  "MD013": false,
  "MD033": false,
  "MD041": false,
  "MD024": { "siblings_only": true }
}
